<div>
    <p>{{attack}}</p>
    <p class="hint">{{localize "IMPMAL_COMMUNITY.Spread.Instructions"}}</p>
    <ol class="spread-targets">
        {{#each tokens}}
        <li class="spread-target">
            <img src="{{img}}" alt="" width="36" height="36">
            <div class="spread-target-name">
                <strong>{{name}}{{#if role}} ({{role}}){{/if}}</strong>
                {{#if status}}<span role="status">{{status}}</span>{{/if}}
            </div>
            <div class="spread-target-actions">
                <button type="button" data-action="dodge" data-token-uuid="{{uuid}}">
                    {{localize "IMPMAL_COMMUNITY.Spread.Dodge"}}
                </button>
                <button type="button" data-action="half" data-token-uuid="{{uuid}}" {{disabled disabled}}>
                    {{localize "IMPMAL_COMMUNITY.Spread.Half"}} ({{../halfDamage}})
                </button>
                <button type="button" data-action="full" data-token-uuid="{{uuid}}" {{disabled disabled}}>
                    {{localize "IMPMAL_COMMUNITY.Spread.Full"}} ({{../fullDamage}})
                </button>
            </div>
        </li>
        {{/each}}
    </ol>
</div>
